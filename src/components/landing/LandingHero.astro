---
import { Image } from "astro:assets";
import badge from "../../assets/ccl-badge.webp";
import badgeDark from "../../assets/ccl-badge-dark.webp";
import LandingButton from "./LandingButton.astro";
---

<section class="hero">
	<div class="hero-copy">
		<div class="brandmark">
			<Image class="badge light" src={badge} alt="" width={40} height={40} loading="eager" />
			<Image class="badge dark" src={badgeDark} alt="" width={40} height={40} loading="eager" />
			<span>Categorical Configuration Language</span>
		</div>

		<h1>Configuration that reads like plain text.</h1>

		<p class="lede">
			CCL stores everything as readable <code>key = value</code> pairs. Indentation makes
			hierarchy. Comments and multiline values come standard.
		</p>

		<div class="syntax-rail" aria-hidden="true">
			<span>root = readable config</span>
			<span class="depth-1">parser = same tree</span>
			<span class="depth-2">ai = deterministic rows</span>
		</div>

		<div class="actions">
			<LandingButton href="/getting-started/" variant="primary" icon="right-arrow">
				Get started
			</LandingButton>
			<LandingButton href="/ai-quickstart/" variant="secondary" icon="rocket">
				Use deterministic syntax with AI
			</LandingButton>
		</div>

		<nav class="trust-strip" aria-label="CCL reference proof">
			<a href="/behavior-reference/">
				<strong>Reference behavior</strong>
				<span>named parser rules</span>
			</a>
			<a href="/reference/conformance-levels/">
				<strong>Conformance levels</strong>
				<span>stable implementation steps</span>
			</a>
			<a href="/test-suite-guide/">
				<strong>Shared test suite</strong>
				<span>fixtures for every parser</span>
			</a>
		</nav>
	</div>

	<div class="hero-code">
		<div class="code-frame">
			<div class="indent-guides" aria-hidden="true">
				<span></span>
				<span></span>
			</div>
			<slot />
		</div>
		<p class="code-caption">Indented rows resolve into the same tree for humans, parsers, and AI tools.</p>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		align-items: center;
		padding: 2rem 0 5rem;
		position: relative;
	}

	@media (min-width: 60rem) {
		.hero {
			grid-template-columns: 1.05fr 0.95fr;
			gap: 5rem;
			padding: 5rem 0 7rem;
		}
	}

	.brandmark {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-2);
		text-transform: uppercase;
	}

	.brandmark .badge {
		width: 2rem;
		height: 2rem;
		object-fit: contain;
	}

	.badge.dark {
		display: none;
	}

	:global([data-theme="dark"]) .badge.dark {
		display: block;
	}
	:global([data-theme="dark"]) .badge.light {
		display: none;
	}

	h1 {
		font-size: clamp(2.4rem, 6vw, 3.6rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 1.6rem 0 0;
		max-width: 16ch;
		text-wrap: balance;
	}

	.lede {
		margin: 1.6rem 0 0;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
		max-width: 46ch;
		text-wrap: pretty;
	}

	.lede code {
		background: color-mix(in srgb, var(--ccl-contrast) 18%, transparent);
		color: var(--ccl-contrast-high);
		padding: 0.05em 0.4em;
		border-radius: 6px;
		font-size: 0.9em;
		font-weight: 600;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.trust-strip {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		width: min(100%, 34rem);
		margin-top: 1.4rem;
		border-block: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 22%, transparent);
	}

	.trust-strip a {
		display: grid;
		gap: 0.18rem;
		padding: 0.7rem 0;
		color: var(--sl-color-white);
		text-decoration: none;
		outline: 2px solid transparent;
		outline-offset: 3px;
	}

	.trust-strip a + a {
		border-top: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 12%, transparent);
	}

	.trust-strip strong {
		color: var(--ccl-contrast-high);
		font-size: var(--sl-text-xs);
		letter-spacing: -0.01em;
	}

	.trust-strip span {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		line-height: 1.35;
	}

	.trust-strip a:hover strong {
		color: var(--sl-color-accent-high);
	}

	.trust-strip a:focus-visible {
		outline-color: var(--ccl-contrast-high);
	}

	@media (min-width: 44rem) {
		.trust-strip {
			grid-template-columns: repeat(3, 1fr);
			column-gap: 1rem;
		}

		.trust-strip a + a {
			border-top: 0;
		}
	}

	.syntax-rail {
		display: grid;
		gap: 0.45rem;
		width: min(100%, 28rem);
		margin-top: 1.7rem;
		padding-block: 0.9rem;
		border-block: 1px solid color-mix(in srgb, var(--ccl-contrast) 36%, transparent);
		color: var(--sl-color-gray-1);
		font: 700 var(--sl-text-sm) / 1.35 "Fira Code", ui-monospace, monospace;
	}

	.syntax-rail span {
		display: block;
	}

	.syntax-rail .depth-1 {
		padding-left: clamp(1.1rem, 4vw, 1.8rem);
		color: var(--sl-color-accent-high);
	}

	.syntax-rail .depth-2 {
		padding-left: clamp(2.2rem, 8vw, 3.6rem);
		color: var(--ccl-contrast-high);
	}

	.code-frame {
		position: relative;
		border-radius: 14px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
		padding: 0.4rem;
		overflow: hidden;
	}

	.indent-guides {
		position: absolute;
		inset: 0.9rem auto 0.9rem 3.1rem;
		z-index: 1;
		display: flex;
		gap: 1.35rem;
		pointer-events: none;
	}

	.indent-guides span {
		width: 1px;
		border-radius: 999px;
		background: linear-gradient(
			to bottom,
			transparent,
			color-mix(in srgb, var(--ccl-contrast-high) 50%, transparent) 18%,
			color-mix(in srgb, var(--sl-color-accent-high) 40%, transparent) 82%,
			transparent
		);
		transform-origin: top;
	}

	/* Let the embedded Expressive Code block sit flush inside the frame. */
	.code-frame :global(.expressive-code) {
		position: relative;
		z-index: 2;
		margin: 0;
	}
	.code-frame :global(.expressive-code pre) {
		border-radius: 10px;
	}

	.code-caption {
		margin: 0.85rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		text-wrap: pretty;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-copy > *,
		.hero-code {
			animation: hero-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
		}
		.brandmark {
			animation-delay: 0.02s;
		}
		h1 {
			animation-delay: 0.08s;
		}
		.lede {
			animation-delay: 0.16s;
		}
		.actions {
			animation-delay: 0.24s;
		}
		.trust-strip {
			animation-delay: 0.3s;
		}
		.hero-code {
			animation-delay: 0.18s;
		}
		.indent-guides span {
			animation: guide-grow 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
			animation-delay: 0.45s;
		}
		.indent-guides span:nth-child(2) {
			animation-delay: 0.58s;
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes guide-grow {
		from {
			transform: scaleY(0);
		}
		to {
			transform: scaleY(1);
		}
	}
</style>
