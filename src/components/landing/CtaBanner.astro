---
import LandingButton from "./LandingButton.astro";
---

<section class="cta">
	<div class="panel">
		<h2>Write a CCL file next.</h2>
		<p>Start with a small working file, or keep the exact syntax rules open while you build.</p>
		<div class="actions">
			<LandingButton href="/getting-started/" variant="primary" icon="right-arrow">
				Write your first file
			</LandingButton>
			<LandingButton href="/syntax-reference/" variant="secondary" icon="open-book">
				Check syntax rules
			</LandingButton>
		</div>
	</div>
</section>

<style>
	.cta {
		padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(4rem, 8vw, 6rem);
	}

	.panel {
		position: relative;
		display: grid;
		gap: 1.5rem;
		align-items: center;
		padding-top: clamp(2rem, 5vw, 3rem);
		border-top: 1px solid color-mix(in srgb, var(--ccl-contrast) 42%, transparent);
	}

	@media (min-width: 58rem) {
		.panel {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: clamp(2rem, 6vw, 5rem);
		}
	}

	h2 {
		font-size: clamp(2.1rem, 5vw, 3.6rem);
		line-height: 1;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}

	p {
		margin: 0.8rem 0 0;
		max-width: 48ch;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		justify-content: flex-start;
		margin-top: 0;
	}
</style>
