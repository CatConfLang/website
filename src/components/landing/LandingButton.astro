---
import { Icon } from "@astrojs/starlight/components";
import type { StarlightIcon } from "@astrojs/starlight/types";

interface Props {
	href: string;
	variant?: "primary" | "secondary";
	icon?: StarlightIcon;
}

const { href, variant = "primary", icon } = Astro.props;
---

<a class:list={["ccl-btn", variant]} href={href}>
	<span><slot /></span>
	{icon && <Icon name={icon} size="1.1em" />}
</a>

<style>
	.ccl-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.4rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: var(--sl-text-base);
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		border: 1px solid transparent;
		transition:
			transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
			background-color 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.18s ease;
	}

	.ccl-btn.primary {
		background: var(--sl-color-accent);
		color: var(--ccl-on-accent);
		box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--sl-color-accent) 80%, transparent);
	}

	.ccl-btn.primary:hover {
		background: color-mix(in srgb, var(--sl-color-accent) 85%, white);
		transform: translateY(-2px);
		box-shadow: 0 14px 30px -12px color-mix(in srgb, var(--sl-color-accent) 80%, transparent);
	}

	.ccl-btn.secondary {
		background: transparent;
		color: var(--ccl-contrast-high);
		border-color: color-mix(in srgb, var(--ccl-contrast) 55%, transparent);
	}

	.ccl-btn.secondary:hover {
		border-color: var(--ccl-contrast);
		background: color-mix(in srgb, var(--ccl-contrast) 12%, transparent);
		transform: translateY(-2px);
	}

	.ccl-btn:active {
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.ccl-btn,
		.ccl-btn:hover {
			transition: background-color 0.18s ease, border-color 0.18s ease;
			transform: none;
		}
	}
</style>
