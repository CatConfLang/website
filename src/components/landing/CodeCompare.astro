---
// Side-by-side readability comparison. Each column receives a real,
// syntax-highlighted code block via a named slot from the MDX page.
---

<section class="compare">
	<header>
		<h2>The same config, easier to read</h2>
		<p>
			CCL keeps the same structure with less punctuation to scan.
			Compare a small service config in CCL and JSON.
		</p>
	</header>

	<div class="compare-layout">
		<div class="col ccl-col">
			<span class="tag">CCL · key = value</span>
			<slot name="ccl" />
		</div>
		<div class="col json-col">
			<span class="tag">JSON · braces</span>
			<slot name="json" />
		</div>
	</div>

	<p class="takeaway"><code>same tree</code>, fewer tokens to scan.</p>
</section>

<style>
	.compare {
		padding: clamp(4.5rem, 9vw, 7rem) 0;
	}

	header {
		display: grid;
		gap: 1rem;
		align-items: end;
	}

	@media (min-width: 56rem) {
		header {
			grid-template-columns: minmax(14rem, 0.58fr) minmax(0, 1fr);
		}
	}

	header h2 {
		max-width: 12ch;
		font-size: clamp(2rem, 4.8vw, 3.2rem);
		line-height: 1;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}

	header p {
		margin: 0.6rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		max-width: 52ch;
		text-wrap: pretty;
	}

	.compare-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1rem, 3vw, 2rem);
		margin-top: clamp(2.2rem, 5vw, 3.5rem);
		align-items: start;
	}

	@media (min-width: 56rem) {
		.compare-layout {
			grid-template-columns: minmax(0, 1.08fr) minmax(16rem, 0.72fr);
		}
	}

	.col {
		position: relative;
		min-width: 0;
	}

	.ccl-col {
		z-index: 1;
	}

	.json-col {
		padding-top: clamp(0.75rem, 4vw, 3rem);
	}

	.tag {
		display: inline-block;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.01em;
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
		margin-bottom: 0.6rem;
	}

	.ccl-col .tag {
		background: var(--sl-color-accent);
		color: var(--ccl-on-accent);
	}

	.json-col .tag {
		background: var(--sl-color-gray-5);
		color: var(--sl-color-gray-1);
	}

	.col :global(.expressive-code) {
		margin: 0;
	}

	.takeaway {
		width: fit-content;
		margin: clamp(1.2rem, 3vw, 2rem) 0 0;
		padding-block: 0.7rem;
		border-block: 1px solid color-mix(in srgb, var(--ccl-contrast) 34%, transparent);
		color: var(--sl-color-gray-1);
		font-size: var(--sl-text-base);
		font-weight: 700;
		line-height: 1.4;
		text-wrap: pretty;
	}

	.takeaway code {
		color: var(--ccl-contrast-high);
		font-family: "Fira Code", ui-monospace, monospace;
		font-size: 0.92em;
	}
</style>
