---
// Side-by-side readability comparison. Each column receives a real,
// syntax-highlighted code block via a named slot from the MDX page.
---

<section class="compare">
	<header>
		<h2>The same config, easier to read</h2>
		<p>
			CCL keeps the same structure with less punctuation to scan.
			Compare a small service config in CCL and JSON.
		</p>
	</header>

	<div class="compare-layout">
		<div class="col ccl-col">
			<span class="tag">CCL · key = value</span>
			<slot name="ccl" />
		</div>
		<div class="col json-col">
			<span class="tag">JSON · braces</span>
			<slot name="json" />
		</div>
	</div>

	<div class="proof" aria-label="CCL implementation proof">
		<a href="/behavior-reference/">
			<strong>behavior = specified</strong>
			<span>Check how each syntax edge case resolves.</span>
		</a>
		<a href="/reference/conformance-levels/">
			<strong>support = staged</strong>
			<span>Build parser support in stable, testable steps.</span>
		</a>
		<a href="/test-suite-guide/">
			<strong>parser = verified</strong>
			<span>Validate parser behavior with the common fixtures.</span>
		</a>
	</div>
</section>

<style>
	.compare {
		padding: clamp(4.5rem, 9vw, 7rem) 0;
	}

	header {
		display: grid;
		gap: 1rem;
		align-items: end;
	}

	@media (min-width: 56rem) {
		header {
			grid-template-columns: minmax(14rem, 0.58fr) minmax(0, 1fr);
		}
	}

	header h2 {
		max-width: 12ch;
		font-size: clamp(2rem, 4.8vw, 3.2rem);
		line-height: 1;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}

	header p {
		margin: 0.6rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		max-width: 52ch;
		text-wrap: pretty;
	}

	.compare-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1rem, 3vw, 2rem);
		margin-top: clamp(2.2rem, 5vw, 3.5rem);
		align-items: start;
	}

	@media (min-width: 56rem) {
		.compare-layout {
			grid-template-columns: minmax(0, 1.08fr) minmax(16rem, 0.72fr);
		}
	}

	.col {
		position: relative;
	}

	.ccl-col {
		z-index: 1;
	}

	.json-col {
		padding-top: clamp(0.75rem, 4vw, 3rem);
		opacity: 0.82;
	}

	.tag {
		display: inline-block;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.1em;
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
		margin-bottom: 0.6rem;
		text-transform: uppercase;
	}

	.ccl-col .tag {
		background: var(--sl-color-accent);
		color: var(--ccl-on-accent);
	}

	.json-col .tag {
		background: var(--sl-color-gray-5);
		color: var(--sl-color-gray-1);
	}

	.col :global(.expressive-code) {
		margin: 0;
	}

	.proof {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin-top: clamp(1.6rem, 4vw, 2.6rem);
		border-block: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 24%, transparent);
	}

	.proof a {
		display: grid;
		gap: 0.35rem;
		padding: 1rem 0;
		color: var(--sl-color-white);
		text-decoration: none;
		outline: 2px solid transparent;
		outline-offset: 3px;
	}

	.proof a + a {
		border-top: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 14%, transparent);
	}

	.proof strong {
		color: var(--ccl-contrast-high);
		font-family: "Fira Code", ui-monospace, monospace;
		font-size: var(--sl-text-sm);
		letter-spacing: -0.01em;
	}

	.proof span {
		max-width: 28ch;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		text-wrap: pretty;
	}

	.proof a:hover strong {
		color: var(--sl-color-accent-high);
	}

	.proof a:focus-visible {
		outline-color: var(--ccl-contrast-high);
	}

	@media (min-width: 58rem) {
		.proof {
			grid-template-columns: repeat(3, 1fr);
			column-gap: clamp(1.5rem, 4vw, 3rem);
		}

		.proof a + a {
			border-top: 0;
		}
	}
</style>
