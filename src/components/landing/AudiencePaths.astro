---
import { Icon } from "@astrojs/starlight/components";

const paths: { title: string; body: string; href: string }[] = [
	{
		title: "Learn CCL",
		body: "Write your first CCL file and understand how indentation, comments, and values work.",
		href: "/getting-started/",
	},
	{
		title: "Implement a parser",
		body: "Build a conformant CCL parser in any language, backed by a shared test suite.",
		href: "/implementing-ccl/",
	},
	{
		title: "Use CCL with AI",
		body: "Prompts and guides that help AI assistants read, write, and generate CCL correctly.",
		href: "/ai-quickstart/",
	},
];

const implementerLinks = [
	{ href: "/parsing-algorithm/", label: "Parser guide" },
	{ href: "/behavior-reference/", label: "Behavior reference" },
	{ href: "/test-suite-guide/", label: "Test suite" },
	{ href: "/reference/conformance-levels/", label: "Conformance levels" },
];
---

<section class="paths">
	<header>
		<h2>Pick your path</h2>
		<p>Start broad, or jump straight to the proof points implementers need.</p>
	</header>

	<div class="path-layout">
		<ul class="primary-paths">
			{
				paths.map((p) => (
					<li>
						<a href={p.href}>
							<span class="path-key" aria-hidden="true"></span>
							<span class="text">
								<span class="title">{p.title}</span>
								<span class="body">{p.body}</span>
							</span>
							<span class="arrow">
								<Icon name="right-arrow" size="1.2rem" />
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<aside class="fast-lane" aria-labelledby="fast-lane-title">
			<h3 id="fast-lane-title">Implementer fast lane</h3>
			<p>Spec stability, edge cases, and validation paths without a warm-up tour.</p>
			<div class="fast-links">
				{
					implementerLinks.map((link) => (
						<a href={link.href}>
							<span>{link.label}</span>
							<span class="mini-arrow" aria-hidden="true">
								<Icon name="right-arrow" size="1em" />
							</span>
						</a>
					))
				}
			</div>
		</aside>
	</div>
</section>

<style>
	.paths {
		padding: clamp(4.5rem, 9vw, 7rem) 0;
	}

	header {
		display: grid;
		gap: 1rem;
		align-items: end;
	}

	@media (min-width: 56rem) {
		header {
			grid-template-columns: minmax(14rem, 0.5fr) minmax(0, 1fr);
		}
	}

	header h2 {
		font-size: clamp(2rem, 4.8vw, 3.2rem);
		line-height: 1;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}

	header p {
		margin: 0.6rem 0 0;
		max-width: 46ch;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		text-wrap: pretty;
	}

	.path-layout {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		margin-top: clamp(2.5rem, 6vw, 4rem);
	}

	@media (min-width: 58rem) {
		.path-layout {
			grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.62fr);
			align-items: center;
		}
	}

	.primary-paths {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
		counter-reset: path;
	}

	.primary-paths li {
		counter-increment: path;
	}

	.primary-paths a {
		position: relative;
		display: grid;
		grid-template-columns: minmax(3rem, auto) 1fr auto;
		align-items: center;
		gap: clamp(0.9rem, 2vw, 1.3rem);
		min-height: 5.75rem;
		padding: 1.25rem 0;
		border-top: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 18%, transparent);
		text-decoration: none;
		color: var(--sl-color-white);
		outline: 2px solid transparent;
		outline-offset: 3px;
		transition:
			transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.2s ease,
			background-color 0.2s ease,
			outline-color 0.2s ease;
	}

	.primary-paths li:last-child a {
		border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 18%, transparent);
	}

	.primary-paths a:hover {
		transform: translateX(6px);
		border-color: color-mix(in srgb, var(--ccl-contrast) 40%, var(--sl-color-accent-high));
		background: transparent;
	}

	.primary-paths a:focus-visible,
	.fast-links a:focus-visible {
		outline-color: var(--ccl-contrast-high);
	}

	@media (hover: none) {
		.primary-paths a:hover {
			transform: none;
			background: transparent;
		}
	}

	.path-key {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 3rem;
		min-height: 3rem;
		color: var(--ccl-contrast-high);
		font: 700 var(--sl-text-sm) / 1 "Fira Code", ui-monospace, monospace;
		flex-shrink: 0;
	}

	.path-key::before {
		content: "path = " counter(path);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.title {
		font-size: clamp(1.2rem, 2.4vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.body {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		text-wrap: pretty;
	}

	.arrow {
		color: var(--sl-color-gray-3);
		transition: transform 0.2s ease;
	}

	.primary-paths a:hover .arrow {
		transform: translateX(3px);
		color: var(--ccl-contrast-high);
	}

	.fast-lane {
		padding-left: clamp(1rem, 3vw, 2rem);
		border-left: 1px solid color-mix(in srgb, var(--ccl-contrast) 38%, transparent);
	}

	.fast-lane h3 {
		margin: 0;
		font-size: var(--sl-text-xl);
		letter-spacing: -0.01em;
	}

	.fast-lane p {
		margin: 0.5rem 0 1rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.fast-links {
		display: grid;
		gap: 0.35rem;
	}

	.fast-links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.35rem;
		min-height: 44px;
		color: var(--sl-color-gray-1);
		padding: 0.35rem 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		text-decoration: none;
		outline: 2px solid transparent;
		outline-offset: 3px;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.fast-links a:hover {
		color: var(--ccl-contrast-high);
	}

	@media (prefers-reduced-motion: reduce) {
		.primary-paths a,
		.primary-paths a:hover,
		.primary-paths a:hover .arrow {
			transform: none;
		}
	}
</style>
