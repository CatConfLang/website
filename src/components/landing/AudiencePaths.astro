---
import { Icon } from "@astrojs/starlight/components";

const paths: { role: string; title: string; body: string; href: string }[] = [
	{
		role: "learner",
		title: "Learn CCL",
		body: "Write your first CCL file and understand how indentation, comments, and values work.",
		href: "/getting-started/",
	},
	{
		role: "implementer",
		title: "Implement a parser",
		body: "Build a conformant CCL parser in any language, backed by a shared test suite.",
		href: "/implementing-ccl/",
	},
	{
		role: "assistant",
		title: "Use CCL with AI",
		body: "Prompts and guides that help AI assistants read, write, and generate CCL correctly.",
		href: "/ai-quickstart/",
	},
];

const implementerLinks = [
	{
		href: "/parsing-algorithm/",
		label: "Parser guide",
		body: "Learn the indentation and continuation rules.",
	},
	{
		href: "/behavior-reference/",
		label: "Behavior reference",
		body: "Check how each edge case resolves.",
	},
	{
		href: "/test-suite-guide/",
		label: "Test suite",
		body: "Validate your parser with shared fixtures.",
	},
	{
		href: "/reference/conformance-levels/",
		label: "Conformance levels",
		body: "Ship support in stable, testable steps.",
	},
];
---

<section class="paths">
	<header>
		<h2>Pick your path</h2>
		<p>Start with the language, or verify parser behavior when exact results matter.</p>
	</header>

	<div class="path-layout">
		<ul class="primary-paths">
			{
				paths.map((p) => (
					<li>
						<a href={p.href}>
							<span class="path-key" aria-hidden="true">{`role = ${p.role}`}</span>
							<span class="text">
								<span class="title">{p.title}</span>
								<span class="body">{p.body}</span>
							</span>
							<span class="arrow">
								<Icon name="right-arrow" size="1.2rem" />
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<aside class="proof-lane" aria-labelledby="proof-lane-title">
			<p class="lane-label">when behavior must be exact</p>
			<h3 id="proof-lane-title">Parser validation path</h3>
			<p>Follow the parser-grade route in order: learn the algorithm, check edge cases, run fixtures, then choose a conformance level.</p>
			<ol class="proof-steps">
				{
					implementerLinks.map((link) => (
						<li>
							<a href={link.href}>
								<span class="proof-text">
									<strong>{link.label}</strong>
									<span>{link.body}</span>
								</span>
								<Icon name="right-arrow" size="1em" />
							</a>
						</li>
					))
				}
			</ol>
		</aside>
	</div>
</section>

<style>
	.paths {
		padding: clamp(4.5rem, 9vw, 7rem) 0;
	}

	header {
		display: grid;
		gap: 1rem;
		align-items: end;
	}

	@media (min-width: 56rem) {
		header {
			grid-template-columns: minmax(14rem, 0.5fr) minmax(0, 1fr);
		}
	}

	header h2 {
		font-size: clamp(2rem, 4.8vw, 3.2rem);
		line-height: 1;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}

	header p {
		margin: 0.6rem 0 0;
		max-width: 46ch;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		text-wrap: pretty;
	}

	.path-layout {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		margin-top: clamp(2.5rem, 6vw, 4rem);
	}

	@media (min-width: 58rem) {
		.path-layout {
			grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.62fr);
			align-items: center;
		}
	}

	.primary-paths {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.primary-paths a {
		position: relative;
		display: grid;
		grid-template-columns: minmax(3rem, auto) 1fr auto;
		align-items: center;
		gap: clamp(0.9rem, 2vw, 1.3rem);
		min-height: 5.75rem;
		padding: 1.25rem 0;
		border-top: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 18%, transparent);
		text-decoration: none;
		color: var(--sl-color-white);
		outline: 2px solid transparent;
		outline-offset: 3px;
		transition:
			transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.2s ease,
			background-color 0.2s ease,
			outline-color 0.2s ease;
	}

	.primary-paths li:last-child a {
		border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 18%, transparent);
	}

	.primary-paths a:hover {
		transform: translateX(6px);
		border-color: color-mix(in srgb, var(--ccl-contrast) 40%, var(--sl-color-accent-high));
		background: transparent;
	}

	.primary-paths a:focus-visible,
	.proof-steps a:focus-visible {
		outline-color: var(--ccl-contrast-high);
	}

	@media (hover: none) {
		.primary-paths a:hover {
			transform: none;
			background: transparent;
		}
	}

	.path-key {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		min-width: clamp(5.4rem, 16vw, 7rem);
		min-height: 3rem;
		color: var(--ccl-contrast-high);
		font: 700 clamp(0.72rem, 1.4vw, var(--sl-text-sm)) / 1.25 "Fira Code",
			ui-monospace, monospace;
		flex-shrink: 0;
	}

	@media (max-width: 40rem) {
		.primary-paths a {
			grid-template-columns: 1fr auto;
			min-height: auto;
		}

		.path-key {
			grid-column: 1 / -1;
			min-height: 1.5rem;
			min-width: 0;
		}
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.title {
		font-size: clamp(1.2rem, 2.4vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.body {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		text-wrap: pretty;
	}

	.arrow {
		color: var(--sl-color-gray-3);
		transition: transform 0.2s ease;
	}

	.primary-paths a:hover .arrow {
		transform: translateX(3px);
		color: var(--ccl-contrast-high);
	}

	.proof-lane {
		padding: clamp(1.1rem, 3vw, 1.6rem) 0 0;
		border-top: 1px solid color-mix(in srgb, var(--ccl-contrast) 38%, transparent);
	}

	@media (min-width: 58rem) {
		.proof-lane {
			padding: clamp(1rem, 3vw, 2rem) 0 clamp(1rem, 3vw, 2rem)
				clamp(1rem, 3vw, 2rem);
			border-top: 0;
			border-left: 1px solid color-mix(in srgb, var(--ccl-contrast) 38%, transparent);
		}
	}

	.lane-label {
		margin: 0 0 0.6rem;
		color: var(--ccl-contrast-high);
		font: 700 var(--sl-text-xs) / 1.2 "Fira Code", ui-monospace, monospace;
	}

	.proof-lane h3 {
		margin: 0;
		font-size: var(--sl-text-xl);
		letter-spacing: -0.01em;
	}

	.proof-lane p {
		margin: 0.5rem 0 1rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.proof-steps {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		gap: 0;
		counter-reset: proof-step;
	}

	.proof-steps li {
		counter-increment: proof-step;
	}

	.proof-steps a {
		display: grid;
		grid-template-columns: 2.4rem 1fr auto;
		align-items: center;
		gap: 0.75rem;
		min-height: 44px;
		color: var(--sl-color-gray-1);
		padding: 0.75rem 0;
		border-top: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 14%, transparent);
		font-size: var(--sl-text-sm);
		font-weight: 700;
		text-decoration: none;
		outline: 2px solid transparent;
		outline-offset: 3px;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.proof-steps li:last-child a {
		border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 14%, transparent);
	}

	.proof-steps a::before {
		content: counter(proof-step);
		color: var(--ccl-contrast-high);
		font: 800 var(--sl-text-xs) / 1 "Fira Code", ui-monospace, monospace;
	}

	.proof-text {
		display: grid;
		gap: 0.2rem;
	}

	.proof-text span {
		color: var(--sl-color-gray-2);
		font-weight: 600;
		line-height: 1.45;
	}

	.proof-steps a:hover {
		color: var(--ccl-contrast-high);
	}

	.proof-steps a:focus-visible {
		outline-color: var(--ccl-contrast-high);
	}

	@media (prefers-reduced-motion: reduce) {
		.primary-paths a,
		.primary-paths a:hover,
		.primary-paths a:hover .arrow {
			transform: none;
		}
	}
</style>
