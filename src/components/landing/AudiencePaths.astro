---
import { Icon } from "@astrojs/starlight/components";
import type { StarlightIcon } from "@astrojs/starlight/types";

const paths: { icon: StarlightIcon; title: string; body: string; href: string }[] = [
	{
		icon: "open-book",
		title: "Learn CCL",
		body: "Write your first CCL file and understand how indentation, comments, and values work.",
		href: "/getting-started/",
	},
	{
		icon: "pencil",
		title: "Implement a parser",
		body: "Build a conformant CCL parser in any language, backed by a shared test suite.",
		href: "/implementing-ccl/",
	},
	{
		icon: "rocket",
		title: "Use CCL with AI",
		body: "Prompts and guides that help AI assistants read, write, and generate CCL correctly.",
		href: "/ai-quickstart/",
	},
];
---

<section class="paths">
	<header>
		<h2>Pick your path</h2>
	</header>

	<ul>
		{
			paths.map((p) => (
				<li>
					<a href={p.href}>
						<span class="ic">
							<Icon name={p.icon} size="1.3rem" />
						</span>
						<span class="text">
							<span class="title">{p.title}</span>
							<span class="body">{p.body}</span>
						</span>
						<span class="arrow">
							<Icon name="right-arrow" size="1.2rem" />
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.paths {
		padding: 5.5rem 0;
	}

	header h2 {
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		letter-spacing: -0.02em;
		margin: 0 0 2rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}

	a {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.1rem;
		padding: 1.25rem 1.4rem;
		border-radius: 14px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
		text-decoration: none;
		color: var(--sl-color-white);
		transition:
			transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	a:hover {
		transform: translateX(4px);
		border-color: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-gray-5));
		background: color-mix(in srgb, var(--sl-color-accent) 8%, var(--sl-color-gray-6));
	}

	.ic {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 10px;
		background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
		color: var(--sl-color-accent-high);
		flex-shrink: 0;
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.title {
		font-size: var(--sl-text-lg);
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.body {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}

	.arrow {
		color: var(--sl-color-gray-3);
		transition: transform 0.2s ease;
	}

	a:hover .arrow {
		transform: translateX(3px);
		color: var(--ccl-contrast-high);
	}

	@media (prefers-reduced-motion: reduce) {
		a,
		a:hover,
		a:hover .arrow {
			transform: none;
		}
	}
</style>
